# Use with a separate SDKCONFIG and build directory; do not overwrite sdkconfig.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_FLATSPHERE_TTS_VOICE_SERHIY=y
# CONFIG_FLATSPHERE_FLASH_FACTORY_NVS is not set
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_USE_MALLOC=y
# eSpeak G2P BSS lives in PSRAM so internal SRAM can hold SIMD weights.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"