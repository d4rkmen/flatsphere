menu "FlatSphere speech"

choice FLATSPHERE_TTS_VOICE
    prompt "Voice"
    default FLATSPHERE_TTS_VOICE_SERHIY
    help
        Exactly one voice is embedded in the firmware (requires ESP32-S3 with
        PSRAM). The language of the clock's announcements follows the voice.

        Each entry maps to components/sanotts/voices/<bundle>/, whose
        bundle.json is hash-checked at configure time. To add a voice, install
        its bundle there and add one entry here plus one default line to
        FLATSPHERE_TTS_VOICE_BUNDLE below.

config FLATSPHERE_TTS_VOICE_SERHIY
    bool "Serhiy — Ukrainian, male"

config FLATSPHERE_TTS_VOICE_KRISTIN
    bool "Kristin — English, female"
endchoice

# Bundle directory under components/sanotts/voices/. Not user-editable: it is
# derived from the choice above so a typo cannot select a missing voice.
config FLATSPHERE_TTS_VOICE_BUNDLE
    string
    default "uk-serhiy" if FLATSPHERE_TTS_VOICE_SERHIY
    default "en-kristin" if FLATSPHERE_TTS_VOICE_KRISTIN

# Announcement language used by main/. The build fails if it disagrees with the
# selected bundle's "language" field.
config FLATSPHERE_TTS_LANG_UK
    bool
    default y if FLATSPHERE_TTS_VOICE_SERHIY

config FLATSPHERE_FLASH_FACTORY_NVS
    bool "Include factory NVS settings in full flash"
    default n
    help
        Destructive: overwrites saved device settings with nvs.csv.
        Leave disabled for firmware updates and voice tests.

endmenu
