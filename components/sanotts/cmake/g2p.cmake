# Model-specific adapter; the local espeak_ng component owns only the engine/data.
function(sanotts_prepare_g2p component generated language)
    file(MAKE_DIRECTORY "${generated}")
    file(READ "${component}/upstream/g2p/esp_g2p.c" g2p)
    macro(g2p_patch old new)
        string(FIND "${g2p}" "${old}" found)
        if(found EQUAL -1)
            message(FATAL_ERROR "sanoTTS G2P patch anchor missing: ${old}")
        endif()
        string(REPLACE "${old}" "${new}" g2p "${g2p}")
    endmacro()
    g2p_patch("if (!g_ready) return -1;" "if (!g_ready || !text || !out || cap < 3) return -1;")
    g2p_patch("if (id >= 0 && n + 2 <= cap)" "if (id >= 0 && n + 3 > cap) return -1;\n                if (id >= 0)")
    g2p_patch("if (sid >= 0 && n + 2 <= cap)" "if (sid >= 0 && n + 3 > cap) return -1; if (sid >= 0)")
    g2p_patch("for (const char *q = p1 - 1; q >= p0; q--) {\n            char c = *q;"
        "for (const char *q = p1; q > p0;) {\n            char c = *--q;")
    g2p_patch("if (n + 1 <= cap) out[n++] = ID_EOS;"
        "if (tp && *(const char *)tp) return -1;\n    out[n++] = ID_EOS;")
    if(language STREQUAL "uk")
        g2p_patch("espeak_ng_SetVoiceByName(\"en\")" "espeak_ng_SetVoiceByName(\"uk\")")
        g2p_patch("espeak ready (voice en)" "espeak ready (voice uk)")
    elseif(NOT language STREQUAL "en")
        message(FATAL_ERROR "Unsupported G2P language: ${language}")
    endif()
    file(WRITE "${generated}/esp_g2p.c" "${g2p}")
endfunction()