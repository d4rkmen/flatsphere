# Also exercised by the host audit without ESP-IDF or network access.
# Input: CONFIG_FLATSPHERE_TTS_VOICE_BUNDLE (bundle directory name) and
# CONFIG_FLATSPHERE_TTS_LANG_UK. Speaker and language come from bundle.json, so
# adding a voice needs no edits here.
# Output: VOICE_DIR, SANOTTS_VOICE, SANOTTS_SPEAKER, SANOTTS_LANGUAGE,
# SANOTTS_EXPERIMENTAL.
function(sanotts_select_voice component)
    set(voice "${CONFIG_FLATSPHERE_TTS_VOICE_BUNDLE}")
    if(NOT voice MATCHES "^[a-z][a-z0-9-]*$")
        message(FATAL_ERROR "No sanoTTS voice selected (FlatSphere speech -> Voice)")
    endif()
    set(dir "${component}/voices/${voice}")
    if(NOT EXISTS "${dir}/bundle.json")
        message(FATAL_ERROR "Voice bundle not installed: ${dir}/bundle.json")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${dir}/bundle.json")
    file(READ "${dir}/bundle.json" manifest)
    string(JSON speaker GET "${manifest}" speaker)
    string(JSON language GET "${manifest}" language)
    string(JSON experimental GET "${manifest}" experimental)
    if(NOT voice STREQUAL "${language}-${speaker}")
        message(FATAL_ERROR "Bundle ${voice} declares ${language}-${speaker}")
    endif()
    if(CONFIG_FLATSPHERE_TTS_LANG_UK)
        set(expected_language uk)
    else()
        set(expected_language en)
    endif()
    if(NOT language STREQUAL expected_language)
        message(FATAL_ERROR "Voice ${voice} is '${language}' but announcements are '${expected_language}'; "
                            "update FLATSPHERE_TTS_LANG_UK in components/sanotts/Kconfig")
    endif()
    foreach(required front_q8.bin model_q8.bin e2e_audio.bin e2e_ids.bin e2e_durs.bin
            model/act_scales.h model/chain_scales.h model/front_q8_meta.h
            model/frozen_norm.h model/fsd_meta.h model/fsd_q8_meta.h model/rb_scales.h)
        string(JSON required_hash ERROR_VARIABLE missing GET "${manifest}" artifacts "${required}" sha256)
        if(missing OR NOT EXISTS "${dir}/${required}")
            message(FATAL_ERROR "Incomplete voice contract: ${voice}/${required}")
        endif()
    endforeach()
    string(JSON count LENGTH "${manifest}" artifacts)
    math(EXPR last "${count} - 1")
    foreach(i RANGE 0 ${last})
        string(JSON name MEMBER "${manifest}" artifacts ${i})
        if(IS_ABSOLUTE "${name}" OR name MATCHES "(^|/)\\.\\.(/|$)")
            message(FATAL_ERROR "Unsafe voice artifact path: ${name}")
        endif()
        string(JSON expected GET "${manifest}" artifacts "${name}" sha256)
        file(SHA256 "${dir}/${name}" actual)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${dir}/${name}")
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Voice artifact hash mismatch: ${voice}/${name}")
        endif()
    endforeach()
    if(experimental)
        message(WARNING "${speaker}: experimental; parity/quality NOT accepted")
    endif()
    message(STATUS "sanoTTS voice: ${voice} (speaker ${speaker}, language ${language})")
    set(VOICE_DIR "${dir}" PARENT_SCOPE)
    set(SANOTTS_VOICE "${voice}" PARENT_SCOPE)
    set(SANOTTS_SPEAKER "${speaker}" PARENT_SCOPE)
    set(SANOTTS_LANGUAGE "${language}" PARENT_SCOPE)
    set(SANOTTS_EXPERIMENTAL "${experimental}" PARENT_SCOPE)
endfunction()