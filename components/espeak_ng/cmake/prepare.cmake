function(espeak_prepare component generated)
    file(READ "${component}/provenance.json" manifest)
    string(JSON count LENGTH "${manifest}" files)
    math(EXPR last "${count} - 1")
    foreach(i RANGE 0 ${last})
        string(JSON name MEMBER "${manifest}" files ${i})
        string(JSON expected GET "${manifest}" files "${name}" sha256)
        file(SHA256 "${component}/${name}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "eSpeak source/data hash mismatch: ${name}")
        endif()
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${component}/${name}")
    endforeach()
    file(MAKE_DIRECTORY "${generated}")
    file(READ "${component}/upstream/src/libespeak-ng/speech.c" speech)
    set(anchor "return GetFileLength(path_home) == -EISDIR;")
    string(FIND "${speech}" "${anchor}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "eSpeak SPIFFS patch anchor missing")
    endif()
    string(REPLACE "${anchor}"
        "if (GetFileLength(path_home) == -EISDIR) return 1;\n\tchar probe[sizeof(path_home)+16];\n\tsnprintf(probe, sizeof(probe), \"%s/phontab\", path_home);\n\tFILE *fp = fopen(probe, \"rb\");\n\tif (!fp) return 0;\n\tfclose(fp);\n\treturn 1;" speech "${speech}")
    file(WRITE "${generated}/speech.c" "${speech}")
endfunction()